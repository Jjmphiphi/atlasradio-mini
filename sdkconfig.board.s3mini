# Layered after sdkconfig.defaults + generated sdkconfig.variant for BOARD_S3_SUPERMINI.

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# Super Mini has native USB, no UART-USB bridge.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_BT_ENABLED=n

# 1-bit 128x64 OLED — tiny LVGL pool. HTTP 256 KB ring stays in the prebuilt engine.
CONFIG_LV_MEM_SIZE_KILOBYTES=32
CONFIG_LV_USE_LODEPNG=n
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_USE_SYSMON=n
CONFIG_LV_USE_OBSERVER=n
CONFIG_LV_FONT_MONTSERRAT_28=n

CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n

# ADF media-protocol / RTSP stack is unused; IPv6 is unused on this AP+STA radio.
CONFIG_MEDIA_PROTOCOL_LIB_ENABLE=n
CONFIG_LWIP_IPV6=n

# LVGL widgets the 128x64 encoder UI never instantiates.
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_MSGBOX=n
CONFIG_LV_USE_SCALE=n
CONFIG_LV_USE_SPAN=n
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_TILEVIEW=n
CONFIG_LV_USE_WIN=n
CONFIG_LV_USE_IMAGEBUTTON=n
# Spinner (Wi-Fi AP wait) requires ARC.
CONFIG_LV_USE_ARC=y
CONFIG_LV_USE_CHECKBOX=n
CONFIG_LV_USE_DROPDOWN=n
CONFIG_LV_USE_ROLLER=n
CONFIG_LV_USE_TABLE=n
CONFIG_LV_USE_CANVAS=n
CONFIG_LV_BUILD_EXAMPLES=n

# INFO log format strings are large; WARN is enough on the Super Mini.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# CONFIG_LOG_DEFAULT_LEVEL_INFO is not set
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y

# Tenstar ESP32-S3FH4R2: 2 MB in-package PSRAM is Quad SPI, not Octal.
# Octal (inherited from AtlasCube defaults) aborts in cpu_start:
#   "octal_psram: PSRAM chip is not connected, or wrong PSRAM line mode"
CONFIG_SPIRAM_MODE_QUAD=y
# CONFIG_SPIRAM_MODE_OCT is not set
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y

# Factory-only layout has no second app slot; rollback would expect otadata.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=n
